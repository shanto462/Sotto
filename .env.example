# Optional. Copy to .env for local development only.
# Normal users never need this file: the onboarding wizard stores API keys in
# the OS keychain. Values in .env take precedence over the keychain.

# OpenRouter API key (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=

# Model settings. Normally chosen in setup or Preferences → API & Models;
# anything set here overrides that choice.
#
# OpenRouter chat model, e.g. anthropic/claude-sonnet-5.5
# OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Audio-capable OpenRouter model for voice transcription, e.g. google/gemini-3.5-flash-lite
# TRANSCRIPTION_MODEL=google/gemini-3.5-flash-lite

# Effort: low | medium | high | xhigh | max (unset: the model's default)
# SOTTO_EFFORT=high

# Max output tokens per answer, including thinking (unset: the model's maximum,
# as chosen in setup)
# MAX_TOKENS=128000

# Local port the Chrome extension talks to (default: 8765).
# If you change it, also change PORT in extension/background.js and the
# host_permissions in extension/manifest.json.
# PORT=8765

# Logging: trace | debug | info | warn | error (default: info)
# LOG_LEVEL=info
# Set to "json" to disable pretty logs in a terminal
# LOG_FORMAT=json
