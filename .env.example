# Optional. Copy to .env for local development only.
# Normal users never need this file: the onboarding wizard stores API keys in
# the OS keychain. Values in .env take precedence over the keychain.

# Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# OpenAI API key, only needed for the voice trigger (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Claude model to call (default: claude-opus-4-7)
# CLAUDE_MODEL=claude-opus-4-7

# Max tokens per answer (default: 2048)
# MAX_TOKENS=2048

# Local port the Chrome extension talks to (default: 8765).
# If you change it, also change PORT in extension/background.js and the
# host_permissions in extension/manifest.json.
# PORT=8765

# Logging: trace | debug | info | warn | error (default: info)
# LOG_LEVEL=info
# Set to "json" to disable pretty logs in a terminal
# LOG_FORMAT=json
